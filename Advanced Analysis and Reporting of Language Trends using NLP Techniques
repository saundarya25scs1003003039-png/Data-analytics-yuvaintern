# Advanced Analysis and Reporting of Language Trends using NLP
# YUVA Intern - Week 4

import re
from collections import Counter

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.feature_extraction.text import CountVectorizer, ENGLISH_STOP_WORDS
from sklearn.decomposition import LatentDirichletAllocation


# -------------------------------------------------
# 1. LOAD DATASET
# -------------------------------------------------

DATA_FILE = "data/dataset.csv"

# Change these if your CSV uses different column names
TEXT_COLUMN = "text"
DATE_COLUMN = "date"

df = pd.read_csv(DATA_FILE)

print("Dataset loaded successfully!")
print("Number of documents:", len(df))


# -------------------------------------------------
# 2. DATA CLEANING
# -------------------------------------------------

df[DATE_COLUMN] = pd.to_datetime(
    df[DATE_COLUMN],
    errors="coerce"
)

df = df.dropna(
    subset=[TEXT_COLUMN, DATE_COLUMN]
).copy()


# -------------------------------------------------
# 3. TEXT PREPROCESSING
# -------------------------------------------------

stop_words = set(ENGLISH_STOP_WORDS)


def clean_text(text):
    text = str(text).lower()

    # Remove URLs
    text = re.sub(
        r"http\S+|www\S+",
        " ",
        text
    )

    # Remove HTML
    text = re.sub(
        r"<[^>]+>",
        " ",
        text
    )

    # Keep only alphabets
    text = re.sub(
        r"[^a-z\s]",
        " ",
        text
    )

    # Tokenization + stop-word removal
    words = [
        word
        for word in text.split()
        if word not in stop_words
        and len(word) > 2
    ]

    return " ".join(words)


df["clean_text"] = df[TEXT_COLUMN].apply(
    clean_text
)

df = df[
    df["clean_text"].str.len() > 0
].copy()

print("Text preprocessing completed!")


# -------------------------------------------------
# 4. FREQUENCY ANALYSIS
# -------------------------------------------------

all_words = " ".join(
    df["clean_text"]
).split()

word_frequency = Counter(all_words)

top_words = word_frequency.most_common(20)

print("\nTop 20 Words:")

for word, count in top_words:
    print(word, ":", count)


# -------------------------------------------------
# 5. TOP WORDS VISUALIZATION
# -------------------------------------------------

words = [x[0] for x in top_words]
counts = [x[1] for x in top_words]

plt.figure(figsize=(10, 6))

plt.barh(
    words[::-1],
    counts[::-1]
)

plt.title(
    "Top 20 Most Frequent Words"
)

plt.xlabel("Frequency")
plt.ylabel("Words")

plt.tight_layout()

plt.savefig(
    "outputs/top_words.png",
    dpi=300
)

plt.show()


# -------------------------------------------------
# 6. DOCUMENT-TERM MATRIX
# -------------------------------------------------

vectorizer = CountVectorizer(
    max_df=0.95,
    min_df=2,
    max_features=5000
)

X = vectorizer.fit_transform(
    df["clean_text"]
)

print("\nDocument-Term Matrix created!")


# -------------------------------------------------
# 7. LDA TOPIC MODELING
# -------------------------------------------------

NUMBER_OF_TOPICS = 5

lda = LatentDirichletAllocation(
    n_components=NUMBER_OF_TOPICS,
    random_state=42,
    learning_method="batch"
)

document_topics = lda.fit_transform(X)

feature_names = (
    vectorizer.get_feature_names_out()
)


# -------------------------------------------------
# 8. DISPLAY TOPICS
# -------------------------------------------------

print("\nDiscovered Topics:\n")

for topic_number, topic in enumerate(
    lda.components_
):

    top_indices = topic.argsort()[:-11:-1]

    topic_words = [
        feature_names[i]
        for i in top_indices
    ]

    print(
        f"Topic {topic_number + 1}: "
        + ", ".join(topic_words)
    )


# -------------------------------------------------
# 9. ADD TOPIC PROPORTIONS
# -------------------------------------------------

for i in range(NUMBER_OF_TOPICS):

    df[f"topic_{i + 1}"] = (
        document_topics[:, i]
    )


# -------------------------------------------------
# 10. TIME PERIOD
# -------------------------------------------------

df["period"] = (
    df[DATE_COLUMN]
    .dt.to_period("M")
    .astype(str)
)


# -------------------------------------------------
# 11. TOPIC TREND ANALYSIS
# -------------------------------------------------

topic_columns = [
    f"topic_{i + 1}"
    for i in range(NUMBER_OF_TOPICS)
]

trend = df.groupby(
    "period"
)[topic_columns].mean()


# -------------------------------------------------
# 12. TOPIC TREND VISUALIZATION
# -------------------------------------------------

plt.figure(figsize=(12, 6))

for i in range(NUMBER_OF_TOPICS):

    plt.plot(
        trend.index,
        trend[f"topic_{i + 1}"],
        marker="o",
        label=f"Topic {i + 1}"
    )

plt.title(
    "Evolution of Topics Over Time"
)

plt.xlabel("Time Period")
plt.ylabel("Average Topic Proportion")

plt.xticks(rotation=45)

plt.legend()

plt.tight_layout()

plt.savefig(
    "outputs/topic_trends.png",
    dpi=300
)

plt.show()


# -------------------------------------------------
# 13. SAVE RESULTS
# -------------------------------------------------

trend.to_csv(
    "outputs/topic_trends.csv"
)

df.to_csv(
    "outputs/processed_nlp_results.csv",
    index=False
)


# -------------------------------------------------
# 14. FINAL MESSAGE
# -------------------------------------------------

print("\n--------------------------------")
print("NLP ANALYSIS COMPLETED")
print("--------------------------------")

print("Results saved in the outputs folder.")
print("Files generated:")
print("- top_words.png")
print("- topic_trends.png")
print("- topic_trends.csv")
print("- processed_nlp_results.csv")
